{
  "hosting": {
    "public": "public", "ignore": ["firebase.json","**/.*"],
    "rewrites": [{"source":"/api/**","run":{"serviceId":"shaadi-api","region":"us-central1"}}],
    "headers": [
      {"source":"**","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Frame-Options","value":"DENY"}]},
      {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},
      {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]},
      {"source":"/admin**","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"}]}
    ]
  }
}
